{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Zenith",
  "description": "Documentation for preparing, configuring, and publishing apps on Zenith Hosting.",
  "markdown": {
    "instructions": [
      "Before creating, changing, or approving zenith-compose.yml, read https://docs.zenith.hosting/llms.txt, then read https://docs.zenith.hosting/content/zenith-compose.md and the complete public schema at https://docs.zenith.hosting/content/zenith-compose-reference.md. Generate only documented fields and follow their validation and completion checks.",
      "Before creating, changing, publishing, or verifying a container image for Zenith, read https://docs.zenith.hosting/content/containerise.md.",
      "Treat these live Markdown pages as the source of truth instead of relying on memory or a copied Zenith Compose specification.",
      "Do not submit an app, merge pull requests, publish container images, or change registry visibility unless the user explicitly authorizes that external action."
    ]
  },
  "colors": {
    "primary": "#5D45B6",
    "light": "#8668DC",
    "dark": "#9275DD"
  },
  "appearance": {
    "default": "system",
    "strict": false
  },
  "background": {
    "color": {
      "light": "#FFFFFF",
      "dark": "#111113"
    }
  },
  "styling": {
    "codeblocks": {
      "theme": {
        "light": "github-light-default",
        "dark": "vitesse-black"
      }
    }
  },
  "favicon": "/favicon.svg",
  "logo": {
    "light": "/assets/wordmark.svg",
    "dark": "/assets/wordmark.svg",
    "href": "https://zenith.hosting"
  },
  "navigation": {
    "pages": [
      {
        "group": "Start here",
        "pages": [
          "index",
          "content/agent-skill"
        ]
      },
      {
        "group": "Publishing guide",
        "pages": [
          "content/quickstart",
          "content/containerise",
          {
            "group": "Create zenith-compose.yml",
            "root": "content/zenith-compose",
            "pages": [
              "content/zenith-compose-reference"
            ]
          },
          "content/submit"
        ]
      }
    ]
  },
  "redirects": [
    {
      "source": "/quickstart",
      "destination": "/content/quickstart"
    },
    {
      "source": "/agent-skill",
      "destination": "/content/agent-skill"
    },
    {
      "source": "/containerise",
      "destination": "/content/containerise"
    },
    {
      "source": "/zenith-compose",
      "destination": "/content/zenith-compose"
    },
    {
      "source": "/zenith-compose-reference",
      "destination": "/content/zenith-compose-reference"
    },
    {
      "source": "/submit",
      "destination": "/content/submit"
    }
  ],
  "navbar": {
    "links": [
      {
        "label": "GitHub",
        "href": "https://github.com/zenith-hosting"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Publish an app",
      "href": "https://app.zenith.hosting/publish"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "footer": {
    "socials": {
      "github": "https://github.com/zenith-hosting"
    }
  }
}
